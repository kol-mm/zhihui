# 复制为 .env，并在部署前替换所有占位值。
# 应用入口仅对宿主机反向代理开放。
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
# 统计按天分组和“今天”所用的时区；时间本身按 UTC 存储，页面按访问者本地时间显示。
APP_TIME_ZONE=Asia/Shanghai

MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_USER=zhihui
MYSQL_PASSWORD=replace-with-a-long-app-password

AI_KNOWLEDGE_JWT_SECRET=replace-with-at-least-32-random-characters
AI_API_KEY=
AI_API_TIMEOUT=30
INTERNAL_NOTIFICATION_TOKEN=replace-with-an-internal-token
# 会话吊销（退出登录、改密、停用账号后立即失效）使用的 Redis 密码。
REDIS_PASSWORD=replace-with-a-long-redis-password

# ---- 选填：邮箱验证码发信 ----
# 不配置时用户仍可绑定邮箱，但无法验证（验证本身也是可选的）。
# SMTP_SECURITY：ssl（通常 465 端口）、starttls（通常 587 端口）或 none。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USERNAME=no-reply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=知汇 <no-reply@example.com>

# ---- 选填：备份（./backup.sh）----
# BACKUP_ROOT=/mnt/backup/zhihui
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MIN=3
# BACKUP_PAUSE_APP=1
# BACKUP_POST_HOOK=rclone copy {} remote:zhihui-backups/{name}
# BACKUP_SCHEDULE=*-*-* 03:30:00

# ---- 选填：巡检与告警（./monitor.sh，./schedule.sh install 安装定时任务）----
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TYPE=wecom
# ALERT_SITE_NAME=知汇
# MONITOR_INTERVAL=5min
# MONITOR_BACKUP_MAX_AGE_HOURS=26
# MONITOR_DISK_MIN_FREE_PERCENT=10
# MONITOR_REPEAT_HOURS=6
# MONITOR_TLS_HOST=zhihui.example.com
# MONITOR_TLS_MIN_DAYS=14
