# 复制为 .env，并在部署前替换所有占位值。
# 应用入口仅对宿主机反向代理开放。
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088

MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_USER=zhihui
MYSQL_PASSWORD=replace-with-a-long-app-password

AI_KNOWLEDGE_JWT_SECRET=replace-with-at-least-32-random-characters
AI_API_KEY=
AI_API_TIMEOUT=30
INTERNAL_NOTIFICATION_TOKEN=replace-with-an-internal-token
