{
  "name": "ai-knowledge-platform-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5173",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "build:linux": "vue-tsc -b && vite build --config vite.config.mjs",
    "test": "vitest run",
    "preview": "vite preview --config vite.config.mjs --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.3",
    "pdfjs-dist": "6.3.289",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
